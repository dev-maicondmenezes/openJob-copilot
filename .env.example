# Local runtime overrides for docker-compose (optional).
# Copy to .env and adjust to your LAN.
OPENJOB_HOSTNAME=openjob.copilot
# IP da máquina na sua LAN (ex.: 192.168.1.10) — usado como fallback se o
# mDNS/hosts-file não resolver. Ajuste para o seu ambiente.
OPENJOB_LAN_IP=192.168.1.10

# Feature flags de release (default: false). Ligue conforme a fase entra no ar.
# OPENJOB_FEATURE_UI_FEED=true
# OPENJOB_FEATURE_EMAIL_SYNC=true
# OPENJOB_FEATURE_CURRICULUM_EXPORT=true
# OPENJOB_FEATURE_SCORE_DETERMINISTIC=true
