# Local runtime overrides for docker-compose (optional).
# Copy to .env and adjust to your LAN.
OPENJOB_HOSTNAME=openjob.copilot
# IP da máquina na sua LAN (ex.: 192.168.1.10) — usado como fallback se o
# mDNS/hosts-file não resolver. Ajuste para o seu ambiente.
OPENJOB_LAN_IP=192.168.1.10

# Feature flags de release habilitadas por padrão no MVP. Defina false/0 para
# rollback de uma feature específica sem trocar o binário.
# OPENJOB_FEATURE_UI_FEED=false
# OPENJOB_FEATURE_EMAIL_SYNC=false
# OPENJOB_FEATURE_CURRICULUM_EXPORT=false
# Motores determinísticos default: true (sem IA, sem custo, sem rate limit).
# Também podem ser desligados para rollback via env.
# OPENJOB_FEATURE_SCORE_DETERMINISTIC=false
# OPENJOB_FEATURE_KEYWORDS_DETERMINISTIC=false
# OPENJOB_FEATURE_FILTER_DETERMINISTIC=false
