{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#ui": "./src/lib/ui/index.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/copy-dist.mjs",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
		"prepare": "npm run paraglide:compile && (svelte-kit sync || echo '')",
		"check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src/routes src/lib/ui",
		"lint:ui": "node scripts/lint-ui.mjs && eslint src/routes",
		"dev:ui": "OPENJOB_DEV_UI=1 vite dev",
		"i18n:check": "node scripts/i18n-check.mjs",
		"test:e2e": "playwright test --project=e2e",
		"test:visual": "bash ../scripts/visual-test.sh",
		"audit:a11y": "playwright test tests/a11y"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-message-format": "^4.5.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vite-pwa/sveltekit": "^2.0.2",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"magicast": "^0.5.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0"
	}
}
