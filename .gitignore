# Secrets & local data — never commit (spec §3.2: data/.master.key is the
# vault secret; back it up together with the DB, never commit it).
data/
*.db
.master.key
.env

# Build artifacts
bin/
node_modules/
dist-tmp/
backend/tmp/
frontend/build/
frontend/.svelte-kit/
# backend/web/dist é gerado pelo build da SPA (npm run build no frontend);
# o .gitkeep permanece para o //go:embed compilar antes do primeiro build.
backend/web/dist/*
!backend/web/dist/.gitkeep

# Editors / OS
.idea/
.vscode/
.DS_Store
